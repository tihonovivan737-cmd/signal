{
  "name": "signal-support-analytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Локальный сервис анализа обращений с ИИ",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "seed": "node --env-file-if-exists=.env server/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "ai:check": "node --env-file-if-exists=.env scripts/check-ai.mjs",
    "ai:prepare": "node --env-file-if-exists=.env scripts/prepare-ai.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.1"
  }
}
